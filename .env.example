# Regulus — environment variables
# Copy to .env.local for local development. Never commit real values.

# ------------------------------------------------------------------
# Supabase (optional). When BOTH NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are set, the waitlist stores rows in the
# Supabase `waitlist` table. When either is missing, the app falls back
# to a local JSON file store at .data/waitlist.json (gitignored).
# ------------------------------------------------------------------

# Supabase project URL (Settings -> API). Public — shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Public — shipped to the browser.
# Not used by the waitlist itself in V1; present for client-side reads later.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET — server only, bypasses row level
# security. Used by the waitlist store and admin views.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Admin
# ------------------------------------------------------------------

# Password for /admin (waitlist table + CSV export). If unset, /admin
# renders "Admin is disabled. Set ADMIN_PASSWORD." Use a long random value;
# changing it signs out all admin sessions.
ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Data source
# ------------------------------------------------------------------

# Set to 1 to skip live ProPublica Nonprofit Explorer fetches and serve
# the bundled fictional sample organizations instead. Leave empty for live data.
DEMO_MODE=
